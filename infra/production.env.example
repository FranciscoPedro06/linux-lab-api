# Settings of the production stack (infra/compose.prod.yml), read with
# `docker compose --env-file`. Copy to /etc/linuxlab/production.env on the host,
# owned by root with mode 0600, and fill in every value. Never commit the copy.
# Image tags come from the release file written by infra/release/build.sh, not from
# here. infra/release/check-env.sh checks this file before a deployment.

# Public name of the site, as in the DNS record: Caddy gets its certificate for it.
SITE_ADDRESS=lab.example.org
# The exact origin browsers use: https:// followed by SITE_ADDRESS. The API refuses
# every non-GET request and WebSocket from any other origin.
PUBLIC_ORIGIN=https://lab.example.org
# ACME directory. While testing a new host, use Let's Encrypt staging:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Password of the PostgreSQL role. Hex only: it is part of DATABASE_URL.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Invite code for sign-up during the closed beta. Empty disables sign-up.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SIGNUP_INVITE_CODE=

# Group id owning /var/run/docker.sock on this host:  stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=

# Label value of this deployment's lab containers. Fixed for the deployment's
# lifetime, and different from any other deployment on the same Docker Engine.
LAB_DEPLOYMENT=prod
# Active labs across all users. Each may use 512 MB and half a CPU; size it to the
# host and leave room for PostgreSQL, the API and Caddy.
LAB_CAPACITY=

# Backups (infra/ops/backup.sh). Local directory. Nothing in it is removed unless
# local retention is enabled below, and then only backups whose copy off the host
# is read back again first (docs/operations.md#local-retention).
BACKUP_DIR=/var/backups/linuxlab
# Public keys every backup is encrypted to, one per line, at least two: the
# operator's and an offline recovery key, made away from this host with
# age-keygen (docs/operations.md#encryption). Required: without it no backup is
# written. Never a private key here or anywhere on this host.
BACKUP_AGE_RECIPIENTS_FILE=/etc/linuxlab/backup-recipients.txt
# Where the unencrypted package exists while a backup is made or restored. The
# default, on /run's tmpfs, keeps it off the disk; see docs/operations.md#encryption.
# BACKUP_WORK_DIR=/run/linuxlab-backup
# Copies off this host (docs/operations.md#copies-off-the-host), with rclone
# (infra/release/install-rclone.sh) to S3-compatible storage. Empty: backups stay on
# this host only, every backup says so and check-labs.sh reports it. The destination
# is still to be chosen; the values below are placeholders, not an account.
# rclone "remote:bucket/prefix": a remote of BACKUP_RCLONE_CONFIG, then the bucket
# and the prefix the host's credential may write and read.
BACKUP_REMOTE=
# rclone's configuration file, holding the host's credential: root's, mode 0600, in
# a directory only root can change. Never shown by any script. The recovery
# credential (list and read) is not this one and is kept off the host
# (docs/operations.md#the-recovery-credential).
# BACKUP_RCLONE_CONFIG=/etc/linuxlab/rclone.conf
# Attempts at each copy, and seconds before the second one (doubled each time after).
# BACKUP_RETRIES=5
# BACKUP_RETRY_DELAY=30
# Hours after which the latest confirmed copy is reported as too old (check-labs.sh,
# backup-status.sh).
# BACKUP_MAX_AGE_HOURS=26
# Days after which prune-backups.sh removes a backup here, once its copy off the host
# is read back again. Empty: disabled. No default: an operator's decision.
BACKUP_LOCAL_RETENTION_DAYS=

# Database the API uses. Changed only to switch to a restored copy in an
# emergency (docs/operations.md#restoring).
# DATABASE_NAME=linuxlab

# Addresses of the internal networks. Change them only if they collide with networks
# already on the host; CADDY_EDGE_IP must stay inside EDGE_SUBNET.
# PUBLIC_SUBNET=172.30.0.0/24
# EDGE_SUBNET=172.30.1.0/24
# DB_SUBNET=172.30.2.0/24
# CADDY_EDGE_IP=172.30.1.2
# API_EDGE_IP=172.30.1.3
