# Credentials of the ngrok agent (infra/compose.ngrok.yml). Copy to
# /etc/linuxlab/ngrok.env on the host, owned by root with mode 0600. Never commit
# the copy. Use an authtoken made for this agent only, restricted with an ACL to
# the endpoint's domain (bind:<domain>), so a leaked token cannot serve elsewhere.
NGROK_AUTHTOKEN=
