# Copy to .env and adjust. Never commit .env.

# development | production
LINUXLAB_ENV=development

DATABASE_URL=postgresql+asyncpg://linuxlab:linuxlab@localhost:5432/linuxlab

# Origins accepted on non-GET requests and on the WebSocket handshake, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Invite code required for sign-up during the closed beta. Empty disables sign-up.
SIGNUP_INVITE_CODE=

# runc is only accepted in development. Production requires runsc.
LAB_RUNTIME=runc
LAB_IMAGE=linuxlab/lab-base:dev
LAB_MAX_ACTIVE=20
LAB_IDLE_TIMEOUT_SECONDS=900
LAB_INPUT_IDLE_TIMEOUT_SECONDS=1800
LAB_MAX_LIFETIME_SECONDS=7200

CONTENT_DIR=./content
