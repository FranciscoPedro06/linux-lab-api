# Copy to .env and adjust. Never commit .env.
# Matches the PostgreSQL service in infra/compose.yml (local development only).

DATABASE_URL=postgresql+asyncpg://linuxlab:linuxlab@localhost:5432/linuxlab

# Origins allowed to send non-GET API requests and open a terminal WebSocket,
# comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Invite code required to sign up. Empty disables sign-up. Use a long random
# value, e.g. from `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
SIGNUP_INVITE_CODE=

# Terminal WebSocket without authentication, for local development only.
DEV_TERMINAL_ACCESS=false

# OCI runtime and image for labs. Docker Desktop cannot run runsc; use runc there.
LAB_OCI_RUNTIME=runsc
LAB_IMAGE=linuxlab/lab-base:dev
