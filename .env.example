# Copy to .env and adjust. Never commit .env.
# Matches the PostgreSQL service in infra/compose.yml (local development only).

# development or production. production (the default when unset) refuses to start
# unless labs run under gVisor: LAB_OCI_RUNTIME=runsc, registered with Docker.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://linuxlab:linuxlab@localhost:5432/linuxlab

# Origins allowed to send non-GET API requests and open a terminal WebSocket,
# comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Invite code required to sign up. Empty disables sign-up. Use a long random
# value, e.g. from `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
SIGNUP_INVITE_CODE=

# OCI runtime and image for labs. Docker Desktop cannot run runsc; use runc there.
LAB_OCI_RUNTIME=runsc
LAB_IMAGE=linuxlab/lab-base:dev

# Value of the linuxlab.deployment label on this API's lab containers. The reaper
# only removes containers with its own value, so deployments sharing a Docker Engine
# must use different ones.
LAB_DEPLOYMENT=default

# Labs in provisioning, ready or terminating across all users. Provisional default;
# see docs/architecture.md, "Values chosen in increment 05".
LAB_CAPACITY=10

# Directory read by `linuxlab content sync`. Defaults to content/ in this repository;
# the production image sets /app/content.
# CONTENT_DIR=
